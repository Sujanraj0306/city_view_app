# Copy this file to `.env` and fill in real values before running docker-compose.

# Gmail account used to send outbound alert emails (use an App Password, not your login password)
GMAIL_USER=your.email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password

# Destination addresses for civic alerts
POLICE_EMAIL=police@example.gov
CORPORATION_EMAIL=corporation@example.gov

# Secret used to sign JWT auth tokens issued by the backend
JWT_SECRET=change-me-to-a-long-random-string

# Optional: override default Postgres credentials
# POSTGRES_USER=civicshield
# POSTGRES_PASSWORD=civicshield
