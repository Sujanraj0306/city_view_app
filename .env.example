# Copy this file to `.env` and fill in real values before running docker-compose.

# Gmail account used to send outbound alert emails (use an App Password, not your login password)
GMAIL_USER=your.email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password

# Destination addresses for civic alerts
POLICE_EMAIL=police@example.gov
CORPORATION_EMAIL=corporation@example.gov

# Secret used to sign JWT auth tokens issued by the backend
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key — used by the backend to validate report images.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Firebase Admin SDK service-account JSON (in-container path).
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key,
# save the file to backend/firebase-key.json on the host, and leave the path below as-is.
# Leave empty to disable FCM push (app still works; pushes become no-ops).
FCM_CREDENTIALS_PATH=/app/firebase-key.json

# Optional: override default Postgres credentials
# POSTGRES_USER=civicshield
# POSTGRES_PASSWORD=civicshield
